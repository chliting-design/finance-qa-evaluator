# Copy to .env for local development with `netlify dev`.
# In production, set these under Netlify → Site configuration → Environment variables.
# NEVER commit a real .env file.

# Required. Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. If set, the page asks for this code once and the function rejects
# requests without it. Recommended so strangers can't spend your credits.
ACCESS_CODE=

# Optional overrides (defaults shown). Any OpenRouter model id works;
# anthropic/claude-haiku-4.5 is a ~4x cheaper alternative with the same prompts.
# MODEL=anthropic/claude-opus-5.5
# MAX_TOKENS=800
# TEMPERATURE=0.2
